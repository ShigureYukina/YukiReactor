<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.yuki</groupId>
    <artifactId>reactor</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Reactor</name>
    <description>Persistent asynchronous task execution engine with lease recovery and adaptive concurrency control</description>

    <modules>
        <module>task-core</module>
        <module>task-api</module>
        <module>task-worker</module>
        <module>task-recovery</module>
        <module>fault-lab</module>
        <module>adaptive-controller</module>
        <module>observability</module>
        <module>app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yuki</groupId>
                <artifactId>reactor-task-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yuki</groupId>
                <artifactId>reactor-task-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yuki</groupId>
                <artifactId>reactor-task-worker</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yuki</groupId>
                <artifactId>reactor-task-recovery</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yuki</groupId>
                <artifactId>reactor-fault-lab</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yuki</groupId>
                <artifactId>reactor-adaptive-controller</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yuki</groupId>
                <artifactId>reactor-observability</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
